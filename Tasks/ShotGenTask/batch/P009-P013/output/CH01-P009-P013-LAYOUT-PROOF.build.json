        ],
        "lines": [
          "Tez touches the three volunteer invitations. A blue",
          "volunteer mark appears on each ticket, and the marks",
          "open a small emergency door in the Gate."
        ],
        "speaker": null,
        "tail": null,
        "tail_source": null
