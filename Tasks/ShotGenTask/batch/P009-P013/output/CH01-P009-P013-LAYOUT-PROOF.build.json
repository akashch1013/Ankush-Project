    "texts": [
      {
        "block_id": "V02-B0173",
        "panel_id": "CH01-P012-PN01",
        "type": "caption",
        "box": [
          38,
          38,
          377.5,
          116.8
        ],
        "lines": [
          "Tara explains that the Bell must ring twice on every",
          "ChandRush night. The first ring opens the fair. The",
          "second ring opens the Moon Path so ChandRush can",
          "fold into its silver wagons and leave before moonset."
        ],
        "speaker": null,
        "tail": null,
        "tail_source": null
      },
      {
        "block_id": "V02-B0174",
        "panel_id": "CH01-P012-PN02",
        "type": "caption",
        "box": [
          38,
          378,
          339.0,
          489.0
        ],
        "lines": [
          "Then she tells them what happened before",
          "the opening. While ChandRush was being",
          "prepared, a tall figure entered the hidden staff",
          "route carrying an old silver ticket and a",
          "polished walking stick. The figure stole the",
          "Moon Bell and moved through the fair."
        ],
        "speaker": null,
        "tail": null,
        "tail_source": null
      }
    ]
  },
