          38,
          314,
          299.4,
          360.6
        ],
        "lines": [
          "Inside Entry Court, Tara waits beside an",
          "empty stand. The Moon Bell is gone."
        ],
        "speaker": null,
        "tail": null,
        "tail_source": null
      }
