    "texts": [
      {
        "block_id": "V02-B0151",
        "panel_id": "CH01-P010-PN01",
        "type": "caption",
        "box": [
          38,
          38,
          425.7,
          149.0
        ],
        "lines": [
          "When something is mathematically wrong, ChandRush",
          "magic copies or exaggerates the mistake. Tez calls this",
          "Moon Mischief. A wrong number can make lights flash at",
          "the wrong time. A wrong fraction can make portions change",
          "size. A wrong shape can make part of a building behave as if",
          "the shape itself is confused."
        ],
        "speaker": null,
        "tail": null,
        "tail_source": null
      },
      {
        "block_id": "V02-B0152",
        "panel_id": "CH01-P010-PN02",
        "type": "balloon",
        "box": [
          474,
          38,
          691.8,
          113.3
        ],
        "lines": [
          "Magic can show us that something",
          "is wrong. It cannot do the maths",
          "for us. We have to understand the",
          "mistake and fix the real thing."
        ],
        "speaker": "Tez",
        "tail": {
          "edge": "bottom",
          "pos": 626.8475007473842,
          "base": 12,
          "tip": [
            693.9258592899304,
            170.79377155377574
          ],
          "length": 88.34613716648923,
          "aims_at": [
            700,
            176
          ],
          "distance_to_target": 96.3
        },
        "tail_source": "layout-default"
      },
      {
        "block_id": "V02-B0153",
        "panel_id": "CH01-P010-PN03",
        "type": "reader",
        "box": [
          462,
          396,
          660,
          525.6
        ],
        "lines": [
          "That includes you,",
          "ChandRush Crew. If the",
          "team needs a",
          "mathematical idea tonight,",
          "learn it with them. They",
          "will use it on the real",
          "repair."
        ],
        "speaker": null,
        "tail": null,
        "tail_source": null
      }
    ]
